# Copier vers .env avec `./scripts/init-env.sh` : chaque valeur "change-me" est remplacée par un
# secret aléatoire. Ne jamais commiter le fichier .env.
POSTGRES_DB=senkyc
POSTGRES_USER=senkyc
POSTGRES_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
# Secrets des clients OAuth2 de démonstration (DEV uniquement)
PARTNER_DEMO_CLIENT_SECRET=change-me
PLATFORM_ADMIN_CLIENT_SECRET=change-me
# Compte applicatif de l'API (sans droit DDL, soumis à la RLS) ; POSTGRES_USER sert aux migrations
SENKYC_APP_DB_PASSWORD=change-me
# Stockage objet (profil Compose "storage") ; ne jamais utiliser les identifiants par défaut de RustFS
STORAGE_ACCESS_KEY=senkyc-storage
STORAGE_SECRET_KEY=change-me
# Clé AES-256 (32 octets en base64) de chiffrement des objets côté application. NE PAS PERDRE : sans elle,
# les objets déjà stockés sont définitivement illisibles. Rotation : ajouter K2 et changer la clé courante.
STORAGE_ENCRYPTION_KEY_K1=change-me-base64
# Jeton partagé API Java <-> service IA
SENKYC_AI_INTERNAL_TOKEN=change-me
