{
  "realm": "senkyc",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      { "name": "senkyc-admin", "description": "Administration de la plateforme SenKYC" },
      { "name": "kyc-partner", "description": "Partenaire intégrateur (client credentials)" }
    ]
  },
  "clients": [
    {
      "clientId": "partner-demo",
      "name": "Partenaire de démonstration (DEV UNIQUEMENT)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${PARTNER_DEMO_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "tenant-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "tenant_id",
            "claim.value": "00000000-0000-0000-0000-0000000000a1",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-partner-demo",
      "enabled": true,
      "serviceAccountClientId": "partner-demo",
      "realmRoles": ["kyc-partner"]
    }
  ]
}
